# Reverse proxy for thebradburygroup.net — all four public services share
# one AWS Elastic IP; Caddy routes by subdomain to the local port each
# service listens on. PostgreSQL has no server block here — never exposed
# publicly, reachable only on localhost/internal docker network.

dev.thebradburygroup.net {
	reverse_proxy localhost:3002
}

api.thebradburygroup.net {
	reverse_proxy localhost:8000
}

cms.thebradburygroup.net {
	reverse_proxy localhost:3003
}

webmaster.thebradburygroup.net {
	reverse_proxy localhost:8001
}
